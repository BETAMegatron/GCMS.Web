@model IEnumerable<GCMS.Web.Models.ViewModels.News.NewsCategoryViewModel>

@{
    ViewData["Title"] = "دسته‌بندی اخبار";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .categories-page {
        direction: rtl;
        background: #f5f7fb;
        min-height: 80vh;
        padding: 55px 20px 80px;
    }

    .categories-container {
        max-width: 1200px;
        margin: auto;
    }

    /* Header */
    .categories-header {
        position: relative;
        background: linear-gradient(135deg, #101c3d, #1d4ed8);
        border-radius: 25px;
        padding: 55px 45px;
        color: white;
        overflow: hidden;
        margin-bottom: 45px;
        box-shadow: 0 15px 40px rgba(29, 78, 216, .12);
    }

        .categories-header::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            top: -150px;
            left: -60px;
        }

        .categories-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            bottom: -120px;
            right: 35%;
        }

    .header-content {
        position: relative;
        z-index: 1;
    }

    .header-label {
        display: inline-block;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.2);
        padding: 8px 17px;
        border-radius: 30px;
        font-size: 13px;
        margin-bottom: 20px;
        color: #dbeafe;
    }

    .categories-header h1 {
        font-size: 34px;
        font-weight: 900;
        margin: 0 0 18px;
    }

    .categories-header p {
        max-width: 750px;
        font-size: 15px;
        line-height: 2.4;
        color: #dbeafe;
        margin: 0;
    }

    /* Section heading */
    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 28px;
    }

        .section-heading h2 {
            color: #172554;
            font-size: 24px;
            font-weight: 900;
            margin: 0;
        }

        .section-heading span {
            color: #64748b;
            font-size: 13px;
        }

    /* Grid */
    .categories-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 25px;
    }

    /* Card */
    .category-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 22px;
        overflow: hidden;
        text-decoration: none !important;
        display: flex;
        flex-direction: column;
        transition: all .3s ease;
        box-shadow: 0 5px 20px rgba(0,0,0,.025);
        color: inherit;
    }

        .category-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 16px 35px rgba(0,0,0,.09);
            border-color: #bfdbfe;
        }

    .category-image-wrapper {
        height: 205px;
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #172554, #2563eb);
    }

    .category-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .5s ease;
    }

    .category-card:hover .category-image {
        transform: scale(1.07);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15,23,42,.65), transparent 65%);
        pointer-events: none;
    }

    .category-image-title {
        position: absolute;
        bottom: 17px;
        right: 20px;
        color: white;
        font-size: 21px;
        font-weight: 900;
        z-index: 1;
    }

    .category-content {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .category-description {
        color: #64748b;
        font-size: 13px;
        line-height: 2.2;
        margin: 0 0 22px;
        min-height: 58px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .category-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #f1f5f9;
        padding-top: 17px;
        margin-top: auto;
    }

    .news-count {
        color: #64748b;
        font-size: 13px;
    }

        .news-count strong {
            color: #2563eb;
            font-size: 19px;
            margin-left: 4px;
        }

    .category-link {
        color: #2563eb;
        font-size: 13px;
        font-weight: 800;
        transition: color .2s ease;
    }

        .category-link i {
            margin-right: 5px;
            transition: transform .2s ease;
        }

    .category-card:hover .category-link i {
        transform: translateX(-5px);
    }

    /* Empty state */
    .empty-categories {
        background: white;
        border: 1px solid #edf0f5;
        border-radius: 22px;
        padding: 65px 20px;
        text-align: center;
        color: #64748b;
    }

    .empty-icon {
        font-size: 45px;
        color: #94a3b8;
        margin-bottom: 18px;
    }

    .empty-categories h3 {
        color: #172554;
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    /* Responsive */
    @@media (max-width: 950px) {
        .categories-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .categories-page {
            padding: 30px 12px 50px;
        }

        .categories-header {
            padding: 38px 25px;
        }

            .categories-header h1 {
                font-size: 27px;
            }

            .categories-header p {
                font-size: 13px;
            }

        .categories-grid {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .category-image-wrapper {
            height: 190px;
        }

        .section-heading h2 {
            font-size: 21px;
        }
    }
</style>

<div class="categories-page">
    <div class="categories-container">

        <!-- Header -->
        <section class="categories-header">
            <div class="header-content">
                <span class="header-label">GCMS NEWS</span>

                <h1>دسته‌بندی اخبار</h1>

                <p>
                    دنیای فناوری و تکنولوژی را از دریچه دسته‌بندی‌های مختلف دنبال کنید.
                    موضوع مورد علاقه خود را انتخاب کنید و تازه‌ترین اخبار آن را بخوانید.
                </p>
            </div>
        </section>

        <!-- Categories -->
        <div class="section-heading">
            <h2>همه دسته‌بندی‌ها</h2>
            <span>دسته‌بندی موردنظر خود را انتخاب کنید</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="categories-grid">

                @foreach (var category in Model)
                {
                    <a asp-controller="News"
                       asp-action="NewsGroup"
                       asp-route-id="@category.NewsCategoryID"
                       class="category-card">

                        <div class="category-image-wrapper">

                            @if (!string.IsNullOrWhiteSpace(category.NewsCategoryImageName))
                            {
                                <img src="@Url.Content("~/Image/NewsCategories/" + category.NewsCategoryImageName)"
                                     alt="@category.NewsCategoryTitle"
                                     class="category-image"
                                     onerror="this.style.display='none';" />
                            }

                            <div class="image-overlay"></div>

                            <h3 class="category-image-title">
                                @category.NewsCategoryTitle
                            </h3>

                        </div>

                        <div class="category-content">

                            <p class="category-description">
                                @(category.NewsCategoryDescription ?? "برای مشاهده اخبار این دسته‌بندی کلیک کنید.")
                            </p>

                            <div class="category-footer">

                                <span class="news-count">
                                    <strong>@category.NewsQuantitiy</strong>
                                    خبر
                                </span>

                                <span class="category-link">
                                    مشاهده اخبار
                                    <i class="fas fa-arrow-left"></i>
                                </span>

                            </div>

                        </div>

                    </a>
                }

            </div>
        }
        else
        {
            <div class="empty-categories">
                <div class="empty-icon">
                    <i class="fas fa-folder-open"></i>
                </div>

                <h3>دسته‌بندی‌ای ثبت نشده است</h3>

                <p>
                    در حال حاضر دسته‌بندی خبری برای نمایش وجود ندارد.
                </p>
            </div>
        }

    </div>
</div>
