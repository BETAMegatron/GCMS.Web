@model IEnumerable<GCMS.Web.Models.ViewModels.News.NewsViewModel>

@{
    ViewData["Title"] = "اخبار دسته‌بندی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .news-group-page {
        direction: rtl;
        padding: 45px 0 70px;
        min-height: 70vh;
        background: #f5f7fb;
    }

    .news-group-container {
        width: 92%;
        max-width: 1250px;
        margin: 0 auto;
    }

    /* Header */
    .news-group-header {
        position: relative;
        overflow: hidden;
        padding: 45px 35px;
        margin-bottom: 40px;
        border-radius: 22px;
        background: linear-gradient(135deg, #101d3a, #193b70);
        color: #fff;
        box-shadow: 0 12px 35px rgba(16, 29, 58, 0.15);
    }

        .news-group-header::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            left: -80px;
            top: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
        }

        .news-group-header h1 {
            position: relative;
            margin: 0 0 15px;
            font-size: 30px;
            font-weight: 800;
        }

        .news-group-header p {
            position: relative;
            margin: 0;
            color: #d5e1f5;
            font-size: 15px;
            line-height: 2;
        }

    .news-group-count {
        display: inline-block;
        position: relative;
        margin-top: 22px;
        padding: 9px 18px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 30px;
        background: rgba(255,255,255,.1);
        color: #fff;
        font-size: 13px;
    }

    /* Breadcrumb */
    .news-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 25px;
        color: #7b8798;
        font-size: 13px;
    }

        .news-breadcrumb a {
            color: #315b99;
            text-decoration: none;
            transition: .2s;
        }

            .news-breadcrumb a:hover {
                color: #102d59;
            }

    /* News Grid */
    .news-group-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 25px;
    }

    .news-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
        border-radius: 18px;
        background: #fff;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 5px 22px rgba(20, 40, 75, .06);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .news-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 14px 32px rgba(20, 40, 75, .13);
        }

    .news-card-image {
        position: relative;
        height: 220px;
        overflow: hidden;
        background: #e8edf5;
    }

        .news-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease;
        }

    .news-card:hover .news-card-image img {
        transform: scale(1.06);
    }

    .news-card-label {
        position: absolute;
        top: 15px;
        right: 15px;
        padding: 6px 13px;
        border-radius: 20px;
        background: rgba(16, 35, 68, .85);
        color: #fff;
        font-size: 11px;
    }

    .news-card-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 20px;
    }

    .news-card-title {
        margin: 0 0 18px;
        color: #172b4d;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.9;
        transition: color .2s;
    }

    .news-card:hover .news-card-title {
        color: #2862a8;
    }

    .news-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid #edf0f5;
    }

    .news-card-date {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #8994a5;
        font-size: 12px;
    }

        .news-card-date svg {
            width: 15px;
            height: 15px;
        }

    .news-card-more {
        color: #2862a8;
        font-size: 12px;
        font-weight: 700;
    }

    /* Empty State */
    .news-empty {
        padding: 65px 20px;
        border: 1px dashed #cbd5e3;
        border-radius: 18px;
        background: #fff;
        text-align: center;
    }

    .news-empty-icon {
        margin-bottom: 15px;
        color: #a4b0c1;
        font-size: 45px;
    }

    .news-empty h3 {
        margin: 0 0 10px;
        color: #263a59;
        font-size: 20px;
    }

    .news-empty p {
        margin: 0;
        color: #8491a4;
        font-size: 14px;
    }

    /* Back Button */
    .news-group-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        margin-top: 40px;
        padding: 12px 22px;
        border-radius: 10px;
        background: #18365f;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s;
    }

        .news-group-back:hover {
            background: #28558e;
            color: #fff;
            transform: translateY(-2px);
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .news-group-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .news-group-page {
            padding: 25px 0 45px;
        }

        .news-group-header {
            padding: 30px 22px;
            margin-bottom: 28px;
            border-radius: 16px;
        }

            .news-group-header h1 {
                font-size: 23px;
            }

            .news-group-header p {
                font-size: 13px;
            }

        .news-group-grid {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .news-card-image {
            height: 210px;
        }

        .news-card-title {
            font-size: 16px;
        }
    }
</style>

<div class="news-group-page">
    <div class="news-group-container">

        <!-- Breadcrumb -->
        <div class="news-breadcrumb">
            <a asp-controller="Home" asp-action="Index">صفحه اصلی</a>
            <span>/</span>
            <a asp-controller="News" asp-action="News">اخبار</a>
            <span>/</span>
            <span>اخبار دسته‌بندی</span>
        </div>

        <!-- Header -->
        <div class="news-group-header">
            <h1>اخبار دسته‌بندی</h1>

            <p>
                در این بخش می‌توانید تمام اخبار منتشرشده در این دسته‌بندی را مشاهده کنید.
            </p>

            <div class="news-group-count">
                @(Model?.Count() ?? 0) خبر
            </div>
        </div>

        <!-- News List -->
        @if (Model != null && Model.Any())
        {
            <div class="news-group-grid">

                @foreach (var news in Model)
                {
                    <a asp-controller="News"
                       asp-action="NewsSingle"
                       asp-route-id="@news.NewsID"
                       class="news-card">

                        <div class="news-card-image">

                            @if (!string.IsNullOrWhiteSpace(news.NewsImageName))
                            {
                                <img src="~/Image/News/@news.NewsImageName"
                                     alt="@news.NewsTitle"
                                     onerror="this.onerror=null;this.src='/Image/News/default-news.jpg';" />
                            }
                            else
                            {
                                <img src="~/Image/News/default-news.jpg"
                                     alt="تصویر پیش‌فرض خبر" />
                            }

                            <span class="news-card-label">خبر</span>
                        </div>

                        <div class="news-card-content">

                            <h2 class="news-card-title">
                                @news.NewsTitle
                            </h2>

                            <div class="news-card-footer">

                                <span class="news-card-date">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">
                                        <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                        <path d="M16 2v4M8 2v4M3 10h18"></path>
                                    </svg>

                                    @if (news.NewsPublishedDate.HasValue)
                                    {
                                        @news.NewsPublishedDate.Value.ToString("yyyy/MM/dd")
                                    }
                                    else
                                    {
                                        <span>تاریخ نامشخص</span>
                                    }
                                </span>

                                <span class="news-card-more">
                                    مشاهده خبر ←
                                </span>

                            </div>
                        </div>

                    </a>
                }

            </div>
        }
        else
        {
            <div class="news-empty">
                <div class="news-empty-icon">📰</div>

                <h3>خبری برای نمایش وجود ندارد</h3>

                <p>
                    در حال حاضر خبری در این دسته‌بندی منتشر نشده است.
                </p>
            </div>
        }

        <!-- Back Button -->
        <a asp-controller="Home"
           asp-action="NewsCategory"
           class="news-group-back">
            بازگشت به دسته بندی
            <span>←</span>
        </a>

    </div>
</div>

