@model IEnumerable<GCMS.Web.Models.ViewModels.News.NewsCategoryViewModel>

@{
    ViewData["Title"] = "اخبار";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .news-page {
        direction: rtl;
        background: #f5f7fb;
        min-height: 100vh;
        padding: 45px 0 70px;
        font-family: inherit;
    }

    .news-container {
        width: min(1200px, 92%);
        margin: auto;
    }

    .news-hero {
        background: linear-gradient(135deg, #101d3a, #173c70);
        border-radius: 22px;
        padding: 45px 35px;
        color: #fff;
        margin-bottom: 45px;
        position: relative;
        overflow: hidden;
    }

        .news-hero::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border: 35px solid rgba(255,255,255,.05);
            border-radius: 50%;
            left: -65px;
            top: -100px;
        }

        .news-hero h1 {
            font-size: 32px;
            font-weight: 900;
            margin-bottom: 12px;
            position: relative;
        }

        .news-hero p {
            color: #d6e2f5;
            font-size: 15px;
            margin: 0;
            position: relative;
            line-height: 2;
        }

    .news-category-section {
        margin-bottom: 55px;
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
        padding-bottom: 15px;
        border-bottom: 2px solid #e1e7f0;
    }

    .category-title {
        font-size: 23px;
        font-weight: 900;
        color: #172b4d;
        margin: 0;
        position: relative;
        padding-right: 15px;
    }

        .category-title::before {
            content: "";
            position: absolute;
            right: 0;
            top: 4px;
            width: 5px;
            height: 27px;
            border-radius: 5px;
            background: #2878d0;
        }

    .view-all {
        text-decoration: none;
        color: #2878d0;
        font-size: 14px;
        font-weight: 800;
        transition: .2s;
        white-space: nowrap;
    }

        .view-all:hover {
            color: #14539a;
            transform: translateX(-4px);
        }

    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .news-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(20, 40, 80, .06);
        transition: .25s;
        border: 1px solid #edf0f5;
    }

        .news-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(20, 40, 80, .12);
        }

    .news-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
        height: 100%;
    }

    .news-image-wrapper {
        height: 205px;
        overflow: hidden;
        background: #e8edf5;
        position: relative;
    }

    .news-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s;
    }

    .news-card:hover .news-image {
        transform: scale(1.06);
    }

    .news-image-placeholder {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8b9bb2;
        font-size: 42px;
    }

    .news-card-content {
        padding: 19px;
    }

    .news-date {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #8491a5;
        font-size: 12px;
        margin-bottom: 12px;
    }

    .news-title {
        font-size: 17px;
        font-weight: 800;
        line-height: 1.9;
        color: #1c2c46;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 64px;
        transition: .2s;
    }

    .news-card:hover .news-title {
        color: #2878d0;
    }

    .empty-news {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 15px;
        padding: 35px 20px;
        text-align: center;
        color: #8491a5;
        font-size: 14px;
    }

        .empty-news i {
            display: block;
            font-size: 32px;
            margin-bottom: 12px;
            color: #aab6c7;
        }

    @@media (max-width: 900px) {
        .news-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .news-page {
            padding: 25px 0 45px;
        }

        .news-hero {
            padding: 30px 22px;
            margin-bottom: 35px;
        }

            .news-hero h1 {
                font-size: 25px;
            }

        .category-header {
            align-items: flex-start;
        }

        .category-title {
            font-size: 19px;
        }

        .news-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .news-image-wrapper {
            height: 220px;
        }
    }
</style>

<div class="news-page">
    <div class="news-container">

        <div class="news-hero">
            <h1>آخرین اخبار دنیای فناوری و بازی</h1>
            <p>
                تازه‌ترین خبرها، رویدادها و تحولات دنیای تکنولوژی،
                سخت‌افزار، هوش مصنوعی و بازی‌های ویدیویی را دنبال کنید.
            </p>
        </div>

        @if (Model != null && Model.Any())
        {
            @foreach (var category in Model)
            {
                <section class="news-category-section">

                    <div class="category-header">
                        <h2 class="category-title">
                            @category.NewsCategoryTitle
                        </h2>

                        <a asp-controller="News"
                           asp-action="Category"
                           asp-route-id="@category.NewsCategoryID"
                           class="view-all">
                            مشاهده همه
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>

                    @if (category.LatestNews != null && category.LatestNews.Any())
                    {
                        <div class="news-grid">

                            @foreach (var news in category.LatestNews.Take(6))
                            {
                                <article class="news-card">

                                    <a asp-controller="News"
                                       asp-action="NewsSingle"
                                       asp-route-id="@news.NewsID"
                                       class="news-card-link">

                                        <div class="news-image-wrapper">

                                            @if (!string.IsNullOrWhiteSpace(news.NewsImageName))
                                            {
                                                <img src="~/Image/News/@news.NewsImageName"
                                                     alt="@news.NewsTitle"
                                                     class="news-image"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                                <div class="news-image-placeholder" style="display:none;">
                                                    <i class="fas fa-newspaper"></i>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="news-image-placeholder">
                                                    <i class="fas fa-newspaper"></i>
                                                </div>
                                            }

                                        </div>

                                        <div class="news-card-content">

                                            <span class="news-date">
                                                <i class="far fa-calendar-alt"></i>

                                                @(news.NewsPublishedDate.HasValue
                                                    ? news.NewsPublishedDate.Value.ToString("yyyy/MM/dd")
                                                    : "تاریخ نامشخص")
                                            </span>

                                            <h3 class="news-title">
                                                @news.NewsTitle
                                            </h3>

                                        </div>

                                    </a>

                                </article>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-news">
                            <i class="fas fa-newspaper"></i>
                            هنوز خبری در این دسته‌بندی منتشر نشده است.
                        </div>
                    }

                </section>
            }
        }
        else
        {
            <div class="empty-news">
                <i class="fas fa-folder-open"></i>
                در حال حاضر خبری برای نمایش وجود ندارد.
            </div>
        }

    </div>
</div>