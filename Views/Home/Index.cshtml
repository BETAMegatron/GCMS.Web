@{
    ViewData["Title"] = "صفحه اصلی";
    Layout = "_Layout";
}

<style>
    .home-page {
        direction: rtl;
        color: #24243a;
        padding: 30px 0 60px;
    }

    .welcome {
        background: linear-gradient(120deg, #eeeaff, #f8f5ff);
        border-radius: 22px;
        padding: 35px;
        margin-bottom: 35px;
    }

        .welcome h1 {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .welcome p {
            color: #77748a;
            font-size: 15px;
            margin: 0;
        }

    .section-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 35px 0 20px;
    }

        .section-title h2 {
            font-size: 21px;
            font-weight: 800;
            margin: 0;
        }

        .section-title a {
            color: #7554d9;
            text-decoration: none;
            font-size: 14px;
        }

    .featured {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 20px;
        margin-bottom: 35px;
    }

    .featured-main {
        position: relative;
        min-height: 340px;
        border-radius: 20px;
        overflow: hidden;
        color: white;
    }

        .featured-main img {
            width: 100%;
            height: 100%;
            min-height: 340px;
            object-fit: cover;
            position: absolute;
        }

    .featured-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(transparent, rgba(0,0,0,.85));
        display: flex;
        flex-direction: column;
        justify-content: end;
        padding: 25px;
    }

    .category {
        background: #7656dc;
        color: white;
        padding: 6px 12px;
        border-radius: 7px;
        font-size: 12px;
        display: inline-block;
        width: fit-content;
        margin-bottom: 12px;
    }

    .featured-overlay h2 {
        font-size: 25px;
        font-weight: 800;
        line-height: 1.8;
    }

    .featured-side {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .side-news {
        display: flex;
        gap: 13px;
        background: white;
        padding: 12px;
        border: 1px solid #eeeef3;
        border-radius: 15px;
        flex: 1;
    }

        .side-news img {
            width: 115px;
            border-radius: 10px;
            object-fit: cover;
        }

        .side-news h3 {
            font-size: 14px;
            line-height: 1.9;
            font-weight: 700;
        }

    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .news-card {
        background: white;
        border: 1px solid #eeeef3;
        border-radius: 17px;
        overflow: hidden;
        transition: .25s;
    }

        .news-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(50,35,100,.08);
        }

        .news-card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
        }

    .news-content {
        padding: 17px;
    }

        .news-content h3 {
            font-size: 16px;
            line-height: 1.9;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .news-content p {
            color: #88869a;
            font-size: 13px;
            line-height: 1.9;
        }

    .news-meta {
        display: flex;
        justify-content: space-between;
        color: #9996a8;
        font-size: 12px;
        margin-top: 15px;
    }

    .game-categories {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .game-item {
        text-align: center;
        background: white;
        border: 1px solid #eeeef3;
        border-radius: 15px;
        padding: 25px 10px;
        color: #39364c;
        font-weight: 700;
        text-decoration: none;
        transition: .2s;
    }

        .game-item:hover {
            background: #f3efff;
            color: #7554d9;
            border-color: #d9ceff;
        }

        .game-item span {
            display: block;
            font-size: 25px;
            margin-bottom: 10px;
        }

    @@media (max-width: 768px) {
        .featured {
            grid-template-columns: 1fr;
        }

        .news-grid {
            grid-template-columns: 1fr;
        }

        .game-categories {
            grid-template-columns: repeat(2, 1fr);
        }

        .welcome h1 {
            font-size: 23px;
        }
    }
</style>

<div class="container home-page">

    <!-- Welcome -->
    <section class="welcome">
        <h1>به دنیای GCMS خوش آمدید 🎮</h1>
        <p>
            جدیدترین اخبار، بررسی‌ها و حواشی دنیای بازی‌های ویدیویی را اینجا دنبال کنید.
        </p>
    </section>

    <!-- Featured News -->
    <div class="section-title">
        <h2>⭐ خبر ویژه</h2>
        <a href="#">مشاهده همه اخبار ←</a>
    </div>

    <section class="featured">

        <div class="featured-main">
            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1000"
                 alt="Gaming News" />

            <div class="featured-overlay">
                <span class="category">اخبار گیمینگ</span>
                <h2>نگاهی به آینده دنیای بازی‌های ویدیویی</h2>
                <small>جدیدترین اتفاقات صنعت بازی را دنبال کنید.</small>
            </div>
        </div>

        <div class="featured-side">

            <div class="side-news">
                <img src="https://images.unsplash.com/photo-1593305841991-05c297ba4575?w=400"
                     alt="Gaming" />
                <div>
                    <span class="category">PlayStation</span>
                    <h3>جدیدترین اخبار دنیای پلی‌استیشن</h3>
                </div>
            </div>

            <div class="side-news">
                <img src="https://images.unsplash.com/photo-1593118247619-e2d6f056869e?w=400"
                     alt="Gaming" />
                <div>
                    <span class="category">PC Gaming</span>
                    <h3>اتفاقات جدید دنیای بازی‌های کامپیوتری</h3>
                </div>
            </div>

        </div>
    </section>

    <!-- Categories -->
    <div class="section-title">
        <h2>🎯 دسته‌بندی بازی‌ها</h2>
    </div>

    <section class="game-categories">

        <a href="#" class="game-item">
            <span>🎮</span>
            PlayStation
        </a>

        <a href="#" class="game-item">
            <span>🟩</span>
            Xbox
        </a>

        <a href="#" class="game-item">
            <span>💻</span>
            PC Gaming
        </a>

        <a href="#" class="game-item">
            <span>📱</span>
            Mobile
        </a>

    </section>

    <!-- Latest News -->
    <div class="section-title">
        <h2>📰 آخرین اخبار</h2>
        <a href="#">همه اخبار ←</a>
    </div>

    <section class="news-grid">

        <article class="news-card">
            <img src="https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?w=700"
                 alt="Gaming" />
            <div class="news-content">
                <span class="category">بازی‌های جدید</span>
                <h3>بررسی جدیدترین بازی‌های منتشر شده</h3>
                <p>با جدیدترین عناوین دنیای بازی و ویژگی‌های آن‌ها آشنا شوید.</p>
                <div class="news-meta">
                    <span>اخبار بازی</span>
                    <span>۵ دقیقه مطالعه</span>
                </div>
            </div>
        </article>

        <article class="news-card">
            <img src="https://images.unsplash.com/photo-1603481546238-487240415921?w=700"
                 alt="Gaming" />
            <div class="news-content">
                <span class="category">تکنولوژی</span>
                <h3>تحولات جدید سخت‌افزارهای گیمینگ</h3>
                <p>نگاهی به تکنولوژی‌های جدید و آینده سخت‌افزارهای بازی.</p>
                <div class="news-meta">
                    <span>تکنولوژی</span>
                    <span>۴ دقیقه مطالعه</span>
                </div>
            </div>
        </article>

        <article class="news-card">
            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?w=700"
                 alt="Gaming" />
            <div class="news-content">
                <span class="category">مسابقات</span>
                <h3>داغ‌ترین رقابت‌های دنیای ورزش‌های الکترونیکی</h3>
                <p>آخرین اتفاقات و رقابت‌های جذاب دنیای Esports.</p>
                <div class="news-meta">
                    <span>Esports</span>
                    <span>۳ دقیقه مطالعه</span>
                </div>
            </div>
        </article>

    </section>

</div>
