@{
    ViewData["Title"] = "خطا";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var errorMessage = ViewBag.ErrorMessage as string ?? "متأسفانه مشکلی پیش آمده است.";
    var errorCode = ViewBag.ErrorCode as string ?? "ERROR";
}

<div class="error-container">
    <div class="error-card">

        <div class="error-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <span class="error-code">@errorCode</span>

        <h1>اوه! مشکلی پیش آمده</h1>

        <p class="error-message">@errorMessage</p>

        <div class="error-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-home">
                <i class="bi bi-house"></i>
                بازگشت به صفحه اصلی
            </a>

            <a href="javascript:history.back()" class="btn-back">
                بازگشت به صفحه قبل
            </a>
        </div>

        <div class="error-footer">
            اگر مشکل ادامه داشت، لطفاً دوباره تلاش کنید.
        </div>

    </div>
</div>

<style>
    .error-container {
        min-height: 65vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 15px;
        direction: rtl;
    }

    .error-card {
        width: 100%;
        max-width: 600px;
        padding: 50px 30px;
        text-align: center;
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 24px;
        box-shadow: 0 15px 45px rgba(0,0,0,0.05);
    }

    .error-icon {
        width: 85px;
        height: 85px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff1f0;
        color: #ef4444;
        border-radius: 25px;
        font-size: 38px;
    }

    .error-code {
        display: inline-block;
        padding: 7px 18px;
        border-radius: 30px;
        background: #f1f5f9;
        color: #64748b;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .error-card h1 {
        font-size: 25px;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 15px;
    }

    .error-message {
        font-size: 15px;
        color: #64748b;
        line-height: 2;
        margin-bottom: 30px;
    }

    .error-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .btn-home,
    .btn-back {
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: bold;
        transition: 0.2s;
    }

    .btn-home {
        background: #6366f1;
        color: white;
    }

    .btn-home:hover {
        background: #4f46e5;
        color: white;
        transform: translateY(-2px);
    }

    .btn-back {
        background: #f1f5f9;
        color: #475569;
    }

    .btn-back:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    .error-footer {
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        font-size: 12px;
        color: #94a3b8;
    }

    @@media(max - width: 480px) {
        .error-card {
            padding: 35px 18px;
        }

        .error-card h1 {
            font-size: 21px;
        }

        .error-actions {
            flex-direction: column;
        }
    }
</style>
