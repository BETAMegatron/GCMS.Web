@model GCMS.Web.Models.ViewModels.General.AboutViewModel

@{
    ViewData["Title"] = "درباره ما";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var aboutImage = string.IsNullOrWhiteSpace(Model.PictureName)
        ? null
        : Url.Content("~/Image/About/" + Model.PictureName);
}

<style>
    .about-page {
        direction: rtl;
        background: #f5f7fb;
        padding: 55px 20px 80px;
        min-height: 80vh;
    }

    .about-container {
        max-width: 1150px;
        margin: auto;
    }

    /* Hero */
    .about-hero {
        position: relative;
        background: linear-gradient(135deg, #101c3d, #1d4ed8);
        border-radius: 25px;
        padding: 65px 50px;
        color: #fff;
        overflow: hidden;
        margin-bottom: 35px;
        box-shadow: 0 15px 40px rgba(29, 78, 216, .14);
    }

        .about-hero::before {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            top: -170px;
            left: -80px;
        }

        .about-hero::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            bottom: -140px;
            right: 35%;
        }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .hero-label {
        display: inline-block;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        padding: 8px 17px;
        border-radius: 30px;
        font-size: 13px;
        margin-bottom: 22px;
        color: #dbeafe;
    }

    .about-hero h1 {
        font-size: 38px;
        font-weight: 900;
        margin: 0 0 20px;
    }

    .about-hero p {
        max-width: 800px;
        font-size: 16px;
        line-height: 2.5;
        color: #e0eaff;
        margin: 0;
        white-space: pre-line;
    }

    /* Main Card */
    .about-main-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 24px;
        padding: 35px;
        box-shadow: 0 8px 30px rgba(0,0,0,.035);
    }

    .about-image-wrapper {
        width: 100%;
        height: 430px;
        border-radius: 20px;
        overflow: hidden;
        background: #edf1f7;
        margin-bottom: 40px;
    }

    .about-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .5s ease;
    }

    .about-image-wrapper:hover .about-image {
        transform: scale(1.035);
    }

    /* Description */
    .about-section-title {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 22px;
    }

    .title-icon {
        width: 48px;
        height: 48px;
        background: #eff6ff;
        color: #2563eb;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .about-section-title h2 {
        font-size: 25px;
        font-weight: 800;
        color: #172554;
        margin: 0;
    }

    .about-description {
        color: #596579;
        font-size: 15px;
        line-height: 2.8;
        white-space: pre-line;
        text-align: justify;
    }

    .section-divider {
        height: 1px;
        background: #edf0f5;
        margin: 35px 0;
    }

    /* Brand section */
    .about-brand {
        background: linear-gradient(135deg, #eff6ff, #f8faff);
        border: 1px solid #e0ebff;
        border-radius: 20px;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-top: 35px;
    }

    .brand-content h3 {
        color: #172554;
        font-size: 22px;
        font-weight: 900;
        margin: 0 0 12px;
    }

    .brand-content p {
        color: #64748b;
        font-size: 14px;
        line-height: 2.2;
        margin: 0;
    }

    .brand-logo {
        min-width: 100px;
        height: 100px;
        background: #1d4ed8;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 25px;
        font-weight: 900;
        box-shadow: 0 10px 25px rgba(29,78,216,.2);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .about-page {
            padding: 30px 12px 50px;
        }

        .about-hero {
            padding: 40px 25px;
            border-radius: 20px;
        }

            .about-hero h1 {
                font-size: 29px;
            }

            .about-hero p {
                font-size: 14px;
            }

        .about-main-card {
            padding: 20px;
        }

        .about-image-wrapper {
            height: 260px;
            margin-bottom: 30px;
        }

        .about-section-title h2 {
            font-size: 21px;
        }

        .about-description {
            font-size: 14px;
            line-height: 2.5;
        }

        .about-brand {
            flex-direction: column-reverse;
            align-items: flex-start;
            padding: 25px;
        }

        .brand-logo {
            min-width: 75px;
            height: 75px;
            font-size: 20px;
        }
    }

    @@media (max-width: 480px) {
        .about-hero h1 {
            font-size: 25px;
        }

        .about-image-wrapper {
            height: 210px;
        }
    }
</style>

<div class="about-page">
    <div class="about-container">

        <!-- Hero -->
        <section class="about-hero">
            <div class="hero-content">
                <span class="hero-label">آشنایی با GCMS</span>

                <h1>درباره ما</h1>

                <p>@Model.AboutShortDescription</p>
            </div>
        </section>

        <!-- Main Content -->
        <section class="about-main-card">

            @if (!string.IsNullOrWhiteSpace(aboutImage))
            {
                <div class="about-image-wrapper">
                    <img src="@aboutImage"
                         alt="درباره GCMS"
                         class="about-image"
                         onerror="this.parentElement.style.display='none';" />
                </div>
            }

            <div class="about-section-title">
                <div class="title-icon">
                    <i class="fas fa-book-open"></i>
                </div>

                <h2>داستان ما</h2>
            </div>

            <div class="about-description">
                @Model.AboutLongDescription
            </div>

            <div class="section-divider"></div>

            <!-- Brand -->
            <div class="about-brand">
                <div class="brand-content">
                    <h3>GCMS؛ فراتر از یک رسانه خبری</h3>

                    <p>
                        ما در GCMS تلاش می‌کنیم با ارائه محتوای باکیفیت،
                        اخبار معتبر و مطالب کاربردی، همراه علاقه‌مندان
                        دنیای فناوری و بازی‌های ویدیویی باشیم.
                    </p>
                </div>

                <div class="brand-logo">
                    GCMS
                </div>
            </div>

        </section>

    </div>
</div>
