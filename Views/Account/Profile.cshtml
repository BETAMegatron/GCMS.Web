@model GCMS.Web.Models.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "پروفایل من";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var profileImage = string.IsNullOrEmpty(Model.UserProfileImageName)
        ? Url.Content("~/images/default-profile.png")
        : Url.Content("~/Image/Profile/" + Model.UserProfileImageName);
}

<style>
    .profile-page {
        max-width: 1100px;
        margin: 45px auto;
        padding: 0 20px;
        direction: rtl;
    }

    .profile-heading {
        margin-bottom: 30px;
    }

        .profile-heading h2 {
            font-size: 27px;
            color: #29283a;
            margin-bottom: 8px;
        }

        .profile-heading p {
            color: #88869a;
            font-size: 14px;
        }

    .profile-container {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 25px;
        align-items: start;
    }

    .profile-card,
    .profile-form-card {
        background: white;
        border: 1px solid #eeeeF4;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(30, 20, 70, .03);
    }

    .profile-card {
        text-align: center;
    }

    .profile-image-wrapper {
        position: relative;
        width: 125px;
        height: 125px;
        margin: 0 auto 18px;
    }

    .profile-image {
        width: 125px;
        height: 125px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #f0ecff;
        background: #f2efff;
    }

    .profile-image-label {
        position: absolute;
        bottom: 3px;
        right: 3px;
        width: 35px;
        height: 35px;
        background: #7454e8;
        color: white;
        border: 3px solid white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
    }

        .profile-image-label:hover {
            background: #6040d0;
        }

    .profile-image-input {
        display: none;
    }

    .profile-card h3 {
        color: #29283a;
        font-size: 19px;
        margin: 10px 0 5px;
    }

    .profile-username {
        color: #8a849f;
        font-size: 13px;
    }

    .profile-status {
        display: inline-block;
        margin-top: 18px;
        padding: 7px 14px;
        border-radius: 20px;
        background: #e9f9ef;
        color: #239b55;
        font-size: 12px;
        font-weight: 700;
    }

        .profile-status.inactive {
            background: #fff0f0;
            color: #d33b3b;
        }

    .profile-info {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeF4;
        text-align: right;
    }

    .profile-info-item {
        margin-bottom: 16px;
    }

        .profile-info-item span {
            display: block;
            color: #9995a8;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .profile-info-item strong {
            color: #55546a;
            font-size: 13px;
            font-weight: 600;
            word-break: break-word;
        }

    .form-section-title {
        font-size: 19px;
        color: #29283a;
        margin: 0 0 7px;
    }

    .form-section-description {
        font-size: 13px;
        color: #9995a8;
        margin-bottom: 25px;
    }

    .profile-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

        .form-group label {
            color: #55546a;
            font-size: 13px;
            font-weight: 600;
        }

    .form-control {
        width: 100%;
        height: 46px;
        border: 1px solid #e8e6ef;
        border-radius: 10px;
        padding: 0 13px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        color: #38364b;
        background: #fff;
        transition: .2s;
    }

        .form-control:focus {
            border-color: #9278f0;
            box-shadow: 0 0 0 3px rgba(116, 84, 232, .08);
        }

    .form-actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-start;
        gap: 12px;
        margin-top: 10px;
    }

    .save-button {
        border: none;
        background: #7454e8;
        color: white;
        padding: 12px 25px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .save-button:hover {
            background: #6040d0;
        }

    .reset-button {
        background: #f3f2f8;
        color: #77758a;
        padding: 12px 22px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        border: none;
        cursor: pointer;
    }

    .password-card {
        margin-top: 25px;
    }

    .password-link {
        display: inline-block;
        color: #7454e8;
        font-size: 13px;
        font-weight: 700;
        margin-top: 12px;
    }

        .password-link:hover {
            color: #6040d0;
        }

    @@media (max-width: 800px) {
        .profile-container {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 550px) {
        .profile-form {
            grid-template-columns: 1fr;
        }

        .form-actions {
            grid-column: 1;
            flex-direction: column;
        }

        .save-button,
        .reset-button {
            width: 100%;
        }
    }
</style>

<div class="profile-page">

    <div class="profile-heading">
        <h2>پروفایل من</h2>
        <p>اطلاعات حساب کاربری خود را مشاهده و ویرایش کنید.</p>
    </div>

    <div class="profile-container">

        <!-- Profile Sidebar -->
        <aside class="profile-card">

            <div class="profile-image-wrapper">

                <img src="@profileImage"
                     alt="تصویر پروفایل"
                     class="profile-image"
                     id="profilePreview" />

                <label for="UserProfileImage" class="profile-image-label">
                    ✎
                </label>

            </div>

            <h3>@Model.FirstName @Model.LastName</h3>

            <div class="profile-username">
                @@Model.Username
            </div>

            @if (Model.UserIsActived)
            {
                <span class="profile-status">
                    ● حساب کاربری فعال
                </span>
            }
            else
            {
                <span class="profile-status inactive">
                    ● حساب کاربری غیرفعال
                </span>
            }

            <div class="profile-info">

                <div class="profile-info-item">
                    <span>شناسه کاربر</span>
                    <strong>@Model.UserID</strong>
                </div>

                <div class="profile-info-item">
                    <span>تاریخ عضویت</span>
                    <strong>@Model.UserCreationDate.ToString("yyyy/MM/dd")</strong>
                </div>

                <div class="profile-info-item">
                    <span>وضعیت حساب</span>
                    <strong>@(Model.UserIsActived ? "فعال" : "غیرفعال")</strong>
                </div>

            </div>

        </aside>

        <!-- Profile Form -->
        <div>

            <section class="profile-form-card">

                <h3 class="form-section-title">اطلاعات شخصی</h3>

                <p class="form-section-description">
                    اطلاعات حساب خود را در این قسمت ویرایش کنید.
                </p>

                <form asp-controller="Account"
                      asp-action="EditProfile"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="file"
                           asp-for="UserProfileImage"
                           class="profile-image-input"
                           accept="image/png,image/jpeg,image/webp" />

                    <div class="profile-form">

                        <div class="form-group">
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="LastName"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Username"></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-actions">

                            <button type="submit" class="save-button">
                                ذخیره تغییرات
                            </button>

                            <button type="reset" class="reset-button">
                                بازنشانی فرم
                            </button>

                        </div>

                    </div>

                </form>

            </section>

            <!-- Password Section -->
            <section class="profile-form-card password-card">

                <h3 class="form-section-title">امنیت حساب کاربری</h3>

                <p class="form-section-description">
                    برای تغییر رمز عبور خود از بخش زیر استفاده کنید.
                </p>

                <a asp-controller="Account"
                   asp-action="ChangePassword"
                   class="password-link">
                    تغییر رمز عبور ←
                </a>

            </section>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        const profileImageInput = document.getElementById("UserProfileImage");
        const profilePreview = document.getElementById("profilePreview");

        profileImageInput.addEventListener("change", function (event) {

            const file = event.target.files[0];

            if (file) {
                profilePreview.src = URL.createObjectURL(file);
            }

        });
    </script>

}
