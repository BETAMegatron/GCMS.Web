
@model GCMS.Web.Models.ViewModels.Account.ProfileViewModel

@{
    ViewData["Title"] = "پروفایل من";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var profileImage = string.IsNullOrEmpty(Model.UserProfileImageName)
        ? Url.Content("~/images/default-profile.png")
        : Url.Content("~/Image/Profile/" + Model.UserProfileImageName);
}

<style>
    .profile-page {
        max-width: 1100px;
        margin: 45px auto;
        padding: 0 20px;
        direction: rtl;
    }

    .profile-heading {
        margin-bottom: 30px;
    }

    .profile-heading h2 {
        font-size: 27px;
        color: #29283a;
        margin-bottom: 8px;
    }

    .profile-heading p {
        color: #88869a;
        font-size: 14px;
    }

    .profile-container {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 25px;
        align-items: start;
    }

    .profile-card,
    .profile-form-card {
        background: white;
        border: 1px solid #eeeeF4;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(30, 20, 70, .03);
    }

    .profile-card {
        text-align: center;
    }

    .profile-image-wrapper {
        position: relative;
        width: 125px;
        height: 125px;
        margin: 0 auto 18px;
    }

    .profile-image {
        width: 125px;
        height: 125px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #f0ecff;
        background: #f2efff;
    }

    .profile-image-label {
        position: absolute;
        bottom: 3px;
        right: 3px;
        width: 35px;
        height: 35px;
        background: #7454e8;
        color: white;
        border: 3px solid white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
    }

    .profile-image-label:hover {
        background: #6040d0;
    }

    .profile-image-input {
        display: none;
    }

    .profile-card h3 {
        color: #29283a;
        font-size: 19px;
        margin: 10px 0 5px;
    }

    .profile-username {
        color: #8a849f;
        font-size: 13px;
    }

    .profile-status {
        display: inline-block;
        margin-top: 18px;
        padding: 7px 14px;
        border-radius: 20px;
        background: #e9f9ef;
        color: #239b55;
        font-size: 12px;
        font-weight: 700;
    }

    .profile-status.inactive {
        background: #fff0f0;
        color: #d33b3b;
    }

    .profile-info {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeF4;
        text-align: right;
    }

    .profile-info-item {
        margin-bottom: 16px;
    }

    .profile-info-item span {
        display: block;
        color: #9995a8;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .profile-info-item strong {
        color: #55546a;
        font-size: 13px;
        font-weight: 600;
        word-break: break-word;
    }

    .form-section-title {
        font-size: 19px;
        color: #29283a;
        margin: 0 0 7px;
    }

    .form-section-description {
        font-size: 13px;
        color: #9995a8;
        margin-bottom: 25px;
    }

    .profile-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .form-group label {
        color: #55546a;
        font-size: 13px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        height: 46px;
        border: 1px solid #e8e6ef;
        border-radius: 10px;
        padding: 0 13px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        color: #38364b;
        background: #fff;
        transition: .2s;
    }

    .form-control:focus {
        border-color: #9278f0;
        box-shadow: 0 0 0 3px rgba(116, 84, 232, .08);
    }

    .form-actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-start;
        gap: 12px;
        margin-top: 10px;
    }

    .save-button {
        border: none;
        background: #7454e8;
        color: white;
        padding: 12px 25px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

    .save-button:hover {
        background: #6040d0;
    }

    .reset-button {
        background: #f3f2f8;
        color: #77758a;
        padding: 12px 22px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        border: none;
        cursor: pointer;
    }

    .password-card {
        margin-top: 25px;
    }

    /* Password Modal */

    .password-link {
        display: inline-block;
        background: #f0ecff;
        color: #7454e8;
        font-size: 13px;
        font-weight: 700;
        margin-top: 5px;
        padding: 11px 18px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-family: inherit;
        transition: .2s;
    }

    .password-link:hover {
        background: #e4dcff;
        color: #6040d0;
    }

    .password-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .55);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 9999;
    }

    .password-modal-overlay.active {
        display: flex;
    }

    .password-modal {
        background: #ffffff;
        width: 100%;
        max-width: 440px;
        padding: 30px;
        border-radius: 20px;
        position: relative;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .15);
        animation: modalShow .25s ease;
    }

    @@keyframes modalShow {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-close {
        position: absolute;
        top: 12px;
        left: 17px;
        border: none;
        background: transparent;
        font-size: 28px;
        color: #94a3b8;
        cursor: pointer;
    }

    .modal-icon {
        width: 55px;
        height: 55px;
        background: #eff6ff;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        margin-bottom: 18px;
    }

    .password-modal h3 {
        font-size: 20px;
        color: #1e293b;
        margin: 0 0 8px;
    }

    .modal-description {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .password-input-group {
        margin-bottom: 17px;
    }

    .password-input-group label {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .password-input-group input {
        width: 100%;
        height: 46px;
        padding: 0 12px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        transition: .2s;
    }

    .password-input-group input:focus {
        border-color: #9278f0;
        box-shadow: 0 0 0 3px rgba(116, 84, 232, .08);
    }

    .password-modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .password-modal-actions button {
        flex: 1;
        padding: 12px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        border: none;
    }

    .cancel-password-btn {
        background: #f1f5f9;
        color: #475569;
    }

    .submit-password-btn {
        background: #7454e8;
        color: #ffffff;
    }

    .submit-password-btn:hover {
        background: #6040d0;
    }

    @@media (max-width: 800px) {
        .profile-container {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 550px) {
        .profile-form {
            grid-template-columns: 1fr;
        }

        .form-actions {
            grid-column: 1;
            flex-direction: column;
        }

        .save-button,
        .reset-button {
            width: 100%;
        }

        .password-modal {
            padding: 24px 18px;
        }
    }
</style>

<div class="profile-page">

    <div class="profile-heading">
        <h2>پروفایل من</h2>
        <p>اطلاعات حساب کاربری خود را مشاهده و ویرایش کنید.</p>
    </div>

    <div class="profile-container">

        <!-- Profile Sidebar -->
        <aside class="profile-card">

            <div class="profile-image-wrapper">

                <img src="@profileImage"
                     alt="تصویر پروفایل"
                     class="profile-image"
                     id="profilePreview" />

                <label for="UserProfileImage" class="profile-image-label">
                    ✎
                </label>

            </div>

            <h3>@Model.FirstName @Model.LastName</h3>

            <div class="profile-username">
                @@Model.Username
            </div>

            @if (Model.UserIsActived)
            {
                <span class="profile-status">
                    ● حساب کاربری فعال
                </span>
            }
            else
            {
                <span class="profile-status inactive">
                    ● حساب کاربری غیرفعال
                </span>
            }

            <div class="profile-info">

                <div class="profile-info-item">
                    <span>شناسه کاربر</span>
                    <strong>@Model.UserID</strong>
                </div>

                <div class="profile-info-item">
                    <span>تاریخ عضویت</span>
                    <strong>@Model.UserCreationDate.ToString("yyyy/MM/dd")</strong>
                </div>

                <div class="profile-info-item">
                    <span>وضعیت حساب</span>
                    <strong>@(Model.UserIsActived ? "فعال" : "غیرفعال")</strong>
                </div>

            </div>

        </aside>

        <!-- Profile Form -->
        <div>

            <section class="profile-form-card">

                <h3 class="form-section-title">اطلاعات شخصی</h3>

                <p class="form-section-description">
                    اطلاعات حساب خود را در این قسمت ویرایش کنید.
                </p>

                <form asp-controller="Account"
                      asp-action="EditProfile"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="file"
                           asp-for="UserProfileImage"
                           class="profile-image-input"
                           accept="image/png,image/jpeg,image/webp" />

                    <div class="profile-form">

                        <div class="form-group">
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="LastName"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Username"></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-actions">

                            <button type="submit" class="save-button">
                                ذخیره تغییرات
                            </button>

                            <button type="reset" class="reset-button">
                                بازنشانی فرم
                            </button>

                        </div>

                    </div>

                </form>

            </section>

            <!-- Password Section -->
            <section class="profile-form-card password-card">

                <h3 class="form-section-title">امنیت حساب کاربری</h3>

                <p class="form-section-description">
                    برای تغییر رمز عبور خود از بخش زیر استفاده کنید.
                </p>

                <button type="button"
                        class="password-link"
                        id="openPasswordModal">
                    🔐 تغییر رمز عبور
                </button>

            </section>

        </div>

    </div>

</div>

<!-- Password Modal -->
<div class="password-modal-overlay" id="passwordModal">

    <div class="password-modal">

        <button type="button"
                class="modal-close"
                id="closePasswordModal">
            &times;
        </button>

        <div class="modal-icon">
            🔐
        </div>

        <h3>تغییر رمز عبور</h3>

        <p class="modal-description">
            برای امنیت حساب کاربری، اطلاعات زیر را وارد کنید.
        </p>

        <form asp-controller="Account"
              asp-action="ChangePassword"
              method="post">

            <div class="password-input-group">
                <label for="CurrentPassword">رمز عبور فعلی</label>
                <input type="password"
                       id="CurrentPassword"
                       name="CurrentPassword"
                       placeholder="رمز عبور فعلی خود را وارد کنید"
                       required />
            </div>

            <div class="password-input-group">
                <label for="NewPassword">رمز عبور جدید</label>
                <input type="password"
                       id="NewPassword"
                       name="NewPassword"
                       placeholder="رمز عبور جدید را وارد کنید"
                       required />
            </div>

            <div class="password-input-group">
                <label for="ConfirmPassword">تکرار رمز عبور جدید</label>
                <input type="password"
                       id="ConfirmPassword"
                       name="ConfirmPassword"
                       placeholder="رمز عبور جدید را تکرار کنید"
                       required />
            </div>

            <div class="password-modal-actions">

                <button type="button"
                        class="cancel-password-btn"
                        id="cancelPasswordModal">
                    انصراف
                </button>

                <button type="submit" class="submit-password-btn">
                    ذخیره رمز عبور
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <script>
        // Profile image preview

        const profileImageInput = document.getElementById("UserProfileImage");
        const profilePreview = document.getElementById("profilePreview");

        profileImageInput.addEventListener("change", function (event) {

            const file = event.target.files[0];

            if (file) {
                profilePreview.src = URL.createObjectURL(file);
            }

        });


        // Password modal

        const passwordModal = document.getElementById("passwordModal");

        const openPasswordModal = document.getElementById("openPasswordModal");
        const closePasswordModal = document.getElementById("closePasswordModal");
        const cancelPasswordModal = document.getElementById("cancelPasswordModal");

        function closeModal() {
            passwordModal.classList.remove("active");
        }

        openPasswordModal.addEventListener("click", function () {
            passwordModal.classList.add("active");
        });

        closePasswordModal.addEventListener("click", closeModal);

        cancelPasswordModal.addEventListener("click", closeModal);

        passwordModal.addEventListener("click", function (event) {
            if (event.target === passwordModal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeModal();
            }
        });
    </script>

}
