</style>

<div class="category-page">

    <!-- Header -->
    <div class="category-header">
        <div>
            <h2>مدیریت دسته‌بندی اخبار</h2>
            <p>در این بخش می‌توانید دسته‌بندی‌های اخبار سایت را مدیریت کنید.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="NewsCategory"
           asp-action="Insert"
           class="btn-add-category">
            <i class="bi bi-plus-circle-fill"></i>
            افزودن دسته‌بندی
        </a>
    </div>

    <!-- Summary -->
    <div class="category-summary">

        <div class="summary-card">
            <div class="summary-icon">
                <i class="bi bi-collection-fill"></i>
            </div>
            <div>
                <h3>@categories.Count</h3>
                <span>تعداد کل دسته‌بندی‌ها</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <h3>@categories.Count(c => c.IsActive)</h3>
                <span>دسته‌بندی‌های فعال</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon" style="background:#fef3c7;color:#d97706;">
                <i class="bi bi-newspaper"></i>
            </div>
            <div>
                <h3>@categories.Sum(c => c.NewsQuantitiy)</h3>
                <span>مجموع اخبار دسته‌بندی‌ها</span>
            </div>
        </div>

    </div>

    <!-- Category table -->
    <div class="category-table-card">

        <div class="table-heading">
            <h3>
                <i class="bi bi-list-ul"></i>
                فهرست دسته‌بندی‌ها
            </h3>
            <span>مدیریت و کنترل دسته‌بندی‌های ثبت‌شده</span>
        </div>

        @if (categories.Any())
        {
            <div class="table-responsive">
                <table class="category-table">
                    <thead>
                        <tr>
                            <th>تصویر</th>
                            <th>عنوان دسته‌بندی</th>
                            <th>توضیحات</th>
                            <th>تعداد اخبار</th>
                            <th>وضعیت</th>
                            <th>تاریخ ایجاد</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in categories)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(category.NewsCategoryImageName))
                                    {
                                        <img src="~/Image/NewsCategory/@category.NewsCategoryImageName"
                                             alt="@category.NewsCategoryTitle"
                                             class="category-image"
                                             onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <div class="category-image d-flex align-items-center justify-content-center">
                                            <i class="bi bi-image text-secondary"></i>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <span class="category-title">
                                        @category.NewsCategoryTitle
                                    </span>
                                </td>

                                <td class="category-description">
                                    @(string.IsNullOrWhiteSpace(category.NewsCategoryDescription)
                                        ? "توضیحاتی ثبت نشده است"
                                        : category.NewsCategoryDescription)
                                </td>

                                <td>
                                    <span class="news-count">
                                        @category.NewsQuantitiy
                                    </span>
                                </td>

                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle-fill"></i>
                                            غیرفعال
                                        </span>
                                    }
                                </td>

                                <td>
                                    @category.NewsCategoryCreationDateToShamsi
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <!-- Edit -->
                                        <a asp-area="Admin"
                                           asp-controller="NewsCategory"
                                           asp-action="Edit"
                                           asp-route-id="@category.NewsCategoryID"
                                           class="action-btn btn-edit">
                                            <i class="bi bi-pencil-square"></i>
                                            ویرایش
                                        </a>

                                        <!-- Activate / Deactivate: no confirmation -->
                                        @if (category.IsActive)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="NewsCategory"
                                                  asp-action="DeactiveNewsCategory"
                                                  asp-route-id="@category.NewsCategoryID"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="action-btn btn-deactivate">
                                                    <i class="bi bi-pause-circle-fill"></i>
                                                    غیرفعال
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="NewsCategory"
                                                  asp-action="ActivateNewsCategory"
                                                  asp-route-id="@category.NewsCategoryID"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="action-btn btn-activate">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    فعال
                                                </button>
                                            </form>
                                        }

                                        <!-- Delete: in-site confirmation modal -->
                                        <button type="button"
                                                class="action-btn btn-delete"
                                                onclick="openDeleteModal('@category.NewsCategoryID', this)"
                                                data-category-name="@category.NewsCategoryTitle"
                                                data-delete-url="@Url.Action("DeleteNewsCategory", "NewsCategory", new { area = "Admin", id = category.NewsCategoryID })">
                                            <i class="bi bi-trash3-fill"></i>
                                            حذف
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-folder-x"></i>
                </div>

                <h4>هنوز دسته‌بندی‌ای ثبت نشده است</h4>
                <p>برای شروع، اولین دسته‌بندی اخبار را ایجاد کنید.</p>

                <a asp-area="Admin"
                   asp-controller="NewsCategory"
                   asp-action="InsertNewCategory"
                   class="btn-add-category">
                    <i class="bi bi-plus-circle-fill"></i>
                    افزودن اولین دسته‌بندی
                </a>
            </div>
        }

    </div>
</div>

<!-- Delete confirmation modal -->
<div class="delete-modal-backdrop"
     id="deleteModal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-modal">

        <div class="delete-modal-icon">
            <i class="bi bi-trash3-fill"></i>
        </div>

        <h3 id="deleteModalTitle">تأیید حذف دسته‌بندی</h3>

        <p>
            آیا از حذف این دسته‌بندی اطمینان دارید؟
            <span class="delete-category-name" id="deleteCategoryName"></span>
            <br />
            این عملیات باعث حذف نرم دسته‌بندی خواهد شد.
        </p>

        <div class="delete-modal-actions">

            <button type="button"
                    class="modal-btn modal-btn-cancel"
                    onclick="closeDeleteModal()">
                انصراف
            </button>

            <form id="deleteCategoryForm" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="modal-btn modal-btn-delete">
                    <i class="bi bi-trash3"></i>
                    بله، حذف شود
                </button>
            </form>

        </div>
    </div>
</div>

<script>
    const deleteModal = document.getElementById('deleteModal');
    const deleteForm = document.getElementById('deleteCategoryForm');
    const deleteCategoryName = document.getElementById('deleteCategoryName');

    function openDeleteModal(id, button) {
        const categoryName = button.getAttribute('data-category-name');
        const deleteUrl = button.getAttribute('data-delete-url');

        deleteCategoryName.textContent = categoryName;
        deleteForm.action = deleteUrl;

        deleteModal.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        deleteModal.classList.remove('show');
        document.body.style.overflow = '';
    }

    deleteModal.addEventListener('click', function(event) {
        if (event.target === deleteModal) {
            closeDeleteModal();
        }
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && deleteModal.classList.contains('show')) {
            closeDeleteModal();
        }
    });
</script>
