        overflow: hidden;
        box-shadow: 0 6px 22px rgba(15,23,42,.04);
    }

    .table-heading {
        padding: 21px 24px;
        border-bottom: 1px solid #edf1f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

        .table-heading h3 {
            color: #172554;
            font-size: 16px;
            font-weight: 800;
            margin: 0;
        }

            .table-heading h3 i {
                color: #2563eb;
