        }

    .btn-activate {
        background: #dcfce7;
        color: #15803d;
    }

        .btn-activate:hover {
            background: #16a34a;
            color: #fff;
        }

    .btn-deactivate {
        background: #fff7ed;
        color: #c2410c;
    }

        .btn-deactivate:hover {
            background: #ea580c;
            color: #fff;
        }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
    }

        .btn-delete:hover {
            background: #dc2626;
