        margin: 0 0 22px;
    }

    .delete-category-name {
        display: block;
        color: #b91c1c;
        font-weight: 900;
        margin-top: 5px;
    }

    .delete-modal-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .modal-btn {
        min-width: 125px;
        border: none;
        border-radius: 10px;
        padding: 11px 17px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s;
    }

        .modal-btn:hover {
            transform: translateY(-2px);
        }

    .modal-btn-cancel {
        background: #f1f5f9;
        color: #475569;
    }

        .modal-btn-cancel:hover {
            background: #e2e8f0;
        }

    .modal-btn-delete {
        background: #dc2626;
        color: #fff;
    }

        .modal-btn-delete:hover {
            background: #b91c1c;
        }

    @@media (max-width: 768px) {
        .category-header {
            padding: 22px;
        }

            .category-header h2 {
                font-size: 19px;
            }

        .table-heading {
            padding: 17px;
        }

        .delete-modal {
            padding: 23px 18px;
        }
    }

    @@media (max-width: 420px) {
        .delete-modal-actions {
            flex-direction: column-reverse;
        }

        .modal-btn {
            width: 100%;
        }
