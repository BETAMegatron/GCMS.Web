        transition: all .2s ease;
    }

        .action-btn i {
            font-size: 13px;
        }

        .action-btn:hover {
            transform: translateY(-2px);
        }

    .btn-edit {
        background: #eff6ff;
        color: #2563eb;
    }

        .btn-edit:hover {
            background: #2563eb;
