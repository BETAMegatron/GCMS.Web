@model IEnumerable<GCMS.Web.Areas.Admin.Models.ViewModel.RP.Roles.RoleShowViewModel>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var roles = Model?.Where(r => !r.Deleted).ToList()
        ?? new List<GCMS.Web.Areas.Admin.Models.ViewModel.RP.Roles.RoleShowViewModel>();

    var activeCount = roles.Count(r => r.RoleIsActived);
    var inactiveCount = roles.Count(r => !r.RoleIsActived);
}

<style>
    .rp-page {
        direction: rtl;
        padding: 20px;
    }

    .rp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .rp-header h2 {
            font-size: 23px;
            font-weight: 700;
            color: #263248;
            margin: 0;
        }

        .rp-header p {
            color: #8490a5;
            font-size: 13px;
            margin: 7px 0 0;
        }

    .rp-header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .rp-btn {
        border: none;
        border-radius: 9px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
        white-space: nowrap;
    }

        .rp-btn:hover {
            opacity: .85;
            color: inherit;
            transform: translateY(-2px);
        }

    .btn-add {
        background: #2563eb;
        color: white;
    }

    .btn-permissions {
        background: #0f766e;
        color: white;
    }

    .rp-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .rp-summary-card {
        background: white;
        border: 1px solid #edf0f5;
        border-radius: 12px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .rp-summary-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .rp-summary-card h4 {
        font-size: 22px;
        margin: 0;
        color: #263248;
        font-weight: 700;
    }

    .rp-summary-card span {
        font-size: 12px;
        color: #8490a5;
    }

    .rp-table-container {
        background: white;
        border: 1px solid #edf0f5;
        border-radius: 13px;
        overflow: hidden;
    }

    .rp-table-header {
        padding: 20px;
        border-bottom: 1px solid #edf0f5;
    }

        .rp-table-header h3 {
            font-size: 17px;
            color: #263248;
            font-weight: 700;
            margin: 0;
        }

    .rp-table-scroll {
        overflow-x: auto;
    }

    .rp-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
    }

        .rp-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            padding: 15px 12px;
            text-align: center;
            white-space: nowrap;
        }

        .rp-table td {
            padding: 15px 12px;
            text-align: center;
            border-bottom: 1px solid #f0f2f6;
            color: #475569;
            font-size: 13px;
            vertical-align: middle;
        }

        .rp-table tr:hover {
            background: #fafcff;
        }

    .rp-name {
        font-weight: 700;
        color: #263248;
    }

    .rp-description {
        max-width: 230px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: auto;
    }

    .rp-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .rp-active {
        background: #dcfce7;
        color: #15803d;
    }

    .rp-inactive {
        background: #fef3c7;
        color: #b45309;
    }

    .rp-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    .rp-action-btn {
        border: none;
        border-radius: 7px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-edit {
        background: #eff6ff;
        color: #2563eb;
    }

    .btn-view {
        background: #f0fdfa;
        color: #0f766e;
    }

    .btn-delete {
        background: #fef2f2;
        color: #dc2626;
    }

    .btn-activate {
        background: #f0fdf4;
        color: #15803d;
    }

    .btn-deactivate {
        background: #fff7ed;
        color: #c2410c;
    }

    .rp-empty {
        padding: 55px 20px;
        text-align: center;
        color: #94a3b8;
    }

        .rp-empty i {
            font-size: 45px;
            display: block;
            margin-bottom: 15px;
        }

        .rp-empty h4 {
            color: #475569;
            font-size: 16px;
        }

    @@media(max-width: 768px) {
        .rp-page {
            padding: 12px;
        }

        .rp-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .rp-summary {
            grid-template-columns: 1fr;
        }

        .rp-header-actions {
            width: 100%;
        }

            .rp-header-actions .rp-btn {
                flex: 1;
            }
    }
</style>

<div class="rp-page">

    <!-- Header -->
    <div class="rp-header">

        <div>
            <h2>
                <i class="bi bi-shield-lock"></i>
                مدیریت نقش‌ها
            </h2>
            <p>تعریف و مدیریت نقش‌های کاربران سیستم</p>
        </div>

        <div class="rp-header-actions">

            <a asp-area="Admin"
               asp-controller="Role"
               asp-action="R_Insert"
               class="rp-btn btn-add">

                <i class="bi bi-plus-circle"></i>
                افزودن نقش
            </a>

            <a asp-area="Admin"
               asp-controller="Permission"
               asp-action="P_Index"
               class="rp-btn btn-permissions">

                <i class="bi bi-shield-check"></i>
                مدیریت دسترسی‌ها
            </a>

        </div>

    </div>

    <!-- Summary -->
    <div class="rp-summary">

        <div class="rp-summary-card">
            <div class="rp-summary-icon"
                 style="background:#eff6ff;color:#2563eb;">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div>
                <h4>@roles.Count</h4>
                <span>کل نقش‌های سیستم</span>
            </div>
        </div>

        <div class="rp-summary-card">
            <div class="rp-summary-icon"
                 style="background:#dcfce7;color:#15803d;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <h4>@activeCount</h4>
                <span>نقش‌های فعال</span>
            </div>
        </div>

        <div class="rp-summary-card">
            <div class="rp-summary-icon"
                 style="background:#fef3c7;color:#b45309;">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <h4>@inactiveCount</h4>
                <span>نقش‌های غیرفعال</span>
            </div>
        </div>

    </div>

    <!-- Roles Table -->
    <div class="rp-table-container">

        <div class="rp-table-header">
            <h3>
                <i class="bi bi-list-ul"></i>
                فهرست نقش‌های ثبت‌شده
            </h3>
        </div>

        <div class="rp-table-scroll">

            <table class="rp-table">

                <thead>
                    <tr>
                        <th>ردیف</th>
                        <th>نام نقش</th>
                        <th>توضیحات</th>
                        <th>تاریخ ایجاد</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (roles.Any())
                    {
                        var counter = 1;

                        foreach (var role in roles)
                        {
                            <tr>

                                <td>@counter</td>

                                <td>
                                    <span class="rp-name">
                                        @role.RoleName
                                    </span>
                                </td>

                                <td>
                                    <div class="rp-description"
                                         title="@role.RoleDescription">
                                        @role.RoleDescription
                                    </div>
                                </td>

                                <td>@role.RoleCreationDateToShamsi</td>

                                <td>
                                    @if (role.RoleIsActived)
                                    {
                                        <span class="rp-status rp-active">
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="rp-status rp-inactive">
                                            غیرفعال
                                        </span>
                                    }
                                </td>

                                <td>

                                    <div class="rp-actions">

                                        <!-- Edit -->
                                        <a asp-area="Admin"
                                           asp-controller="Role"
                                           asp-action="R_Edit"
                                           asp-route-id="@role.RoleID"
                                           class="rp-action-btn btn-edit">

                                            <i class="bi bi-pencil-square"></i>
                                            ویرایش
                                        </a>

                                        <!-- View Permissions -->
                                        <a asp-area="Admin"
                                           asp-controller="Role"
                                           asp-action="R_Permissions"
                                           asp-route-id="@role.RoleID"
                                           class="rp-action-btn btn-view">

                                            <i class="bi bi-shield-check"></i>
                                            مشاهده دسترسی‌ها
                                        </a>

                                        <!-- Activation -->
                                        <form asp-area="Admin"
                                              asp-controller="Role"
                                              asp-action="R_Activation"
                                              asp-route-id="@role.RoleID"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            @if (role.RoleIsActived)
                                            {
                                                <button type="submit"
                                                        class="rp-action-btn btn-deactivate">

                                                    <i class="bi bi-pause-circle"></i>
                                                    غیرفعال
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="rp-action-btn btn-activate">

                                                    <i class="bi bi-check-circle"></i>
                                                    فعال
                                                </button>
                                            }

                                        </form>

                                        <!-- Delete -->
                                        <form asp-area="Admin"
                                              asp-controller="Role"
                                              asp-action="R_Delete"
                                              asp-route-id="@role.RoleID"
                                              method="post"
                                              onsubmit="return confirm('آیا از حذف این نقش اطمینان دارید؟');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="rp-action-btn btn-delete">

                                                <i class="bi bi-trash"></i>
                                                حذف
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">

                                <div class="rp-empty">

                                    <i class="bi bi-shield-x"></i>

                                    <h4>هنوز نقشی ثبت نشده است</h4>

                                    <p>برای شروع، اولین نقش سیستم را ایجاد کنید.</p>

                                    <a asp-area="Admin"
                                       asp-controller="Role"
                                       asp-action="R_Insert"
                                       class="rp-btn btn-add">

                                        <i class="bi bi-plus-circle"></i>
                                        افزودن نقش
                                    </a>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
