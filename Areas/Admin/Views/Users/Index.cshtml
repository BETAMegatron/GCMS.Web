@model IEnumerable<GCMS.Web.Areas.Admin.Models.ViewModel.User.UserShowViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var users = Model?.Where(u => !u.Deleted).ToList()
        ?? new List<GCMS.Web.Areas.Admin.Models.ViewModel.User.UserShowViewModel>();
}

<style>
    .user-page {
        direction: rtl;
        padding: 12px 0 35px;
        font-family: inherit;
        color: #1e293b;
    }

    .user-header {
        background: linear-gradient(125deg, #172554 0%, #1e40af 55%, #2563eb 100%);
        color: #fff;
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 12px 30px rgba(30, 64, 175, .16);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

        .user-header h2 {
            font-size: 23px;
            font-weight: 800;
            margin: 0 0 10px;
        }

        .user-header p {
            color: rgba(255,255,255,.78);
            margin: 0;
            font-size: 13px;
            line-height: 1.9;
        }

    .btn-add-user {
        background: #fff;
        color: #1d4ed8;
        border: 1px solid rgba(255,255,255,.5);
        border-radius: 12px;
        padding: 12px 19px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        transition: all .2s ease;
        box-shadow: 0 5px 14px rgba(15,23,42,.12);
        white-space: nowrap;
    }

        .btn-add-user:hover {
            background: #eff6ff;
            color: #1e3a8a;
            transform: translateY(-2px);
        }

        .btn-add-user i {
            font-size: 17px;
        }

    .user-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 16px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        padding: 19px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 5px 18px rgba(15,23,42,.035);
        transition: .2s;
    }

        .summary-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 22px rgba(15,23,42,.07);
        }

    .summary-icon {
        width: 49px;
        height: 49px;
        border-radius: 14px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .summary-card h3 {
        font-size: 23px;
        font-weight: 800;
        color: #172554;
        margin: 0 0 5px;
    }

    .summary-card span {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .user-table-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(15,23,42,.04);
    }

    .table-heading {
        padding: 21px 24px;
        border-bottom: 1px solid #edf1f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

        .table-heading h3 {
            color: #172554;
            font-size: 16px;
            font-weight: 800;
            margin: 0;
        }

            .table-heading h3 i {
                color: #2563eb;
                margin-left: 6px;
            }

        .table-heading span {
            color: #94a3b8;
            font-size: 12px;
            font-weight: 600;
        }

    .table-responsive {
        overflow-x: auto;
    }

    .user-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .user-table thead {
            background: #f8fafc;
        }

        .user-table th {
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
            padding: 17px 12px;
            text-align: center;
            white-space: nowrap;
            border-bottom: 1px solid #e9eef5;
        }

        .user-table td {
            color: #334155;
            font-size: 12px;
            font-weight: 600;
            padding: 15px 12px;
            text-align: center;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .user-table tbody tr {
            transition: background .2s;
        }

            .user-table tbody tr:hover {
                background: #f8fbff;
            }

            .user-table tbody tr:last-child td {
                border-bottom: none;
            }

    .user-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 190px;
        text-align: right;
    }

    .user-image {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        flex-shrink: 0;
    }

    .user-image-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: #eff6ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .user-name {
        color: #172554;
        font-weight: 800;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .user-username {
        color: #94a3b8;
        font-size: 11px;
        direction: ltr;
        text-align: right;
    }

    .user-email {
        direction: ltr;
        text-align: right;
        display: inline-block;
        color: #64748b;
        font-size: 12px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-inactive {
        background: #fee2e2;
        color: #b91c1c;
    }

    .action-buttons {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: nowrap;
        gap: 7px;
        width: max-content;
        margin: 0 auto;
    }

        .action-buttons form {
            width: 150px;
            margin: 0;
            flex-shrink: 0;
        }

    .action-btn {
        width: 150px;
        box-sizing: border-box;
        border: none;
        border-radius: 9px;
        padding: 9px 11px;
        min-height: 38px;
        font-family: inherit;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        cursor: pointer;
        white-space: nowrap;
        transition: all .2s ease;
    }

        .action-btn i {
            font-size: 13px;
        }

        .action-btn:hover {
            transform: translateY(-2px);
        }

        .action-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
            transform: none;
        }

    .btn-edit {
        background: #eff6ff;
        color: #2563eb;
    }

        .btn-edit:hover {
            background: #2563eb;
            color: #fff;
        }

    .btn-impersonate {
        background: #f3e8ff;
        color: #7e22ce;
    }

        .btn-impersonate:hover {
            background: #9333ea;
            color: #fff;
        }

        .btn-impersonate:disabled:hover {
            background: #f3e8ff;
            color: #7e22ce;
        }

    .btn-activate {
        background: #dcfce7;
        color: #15803d;
    }

        .btn-activate:hover {
            background: #16a34a;
            color: #fff;
        }

    .btn-deactivate {
        background: #fff7ed;
        color: #c2410c;
    }

        .btn-deactivate:hover {
            background: #ea580c;
            color: #fff;
        }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
    }

        .btn-delete:hover {
            background: #dc2626;
            color: #fff;
        }

    .empty-state {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 17px;
        border-radius: 22px;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }

    .empty-state h4 {
        color: #334155;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 9px;
    }

    .empty-state p {
        color: #94a3b8;
        font-size: 13px;
        margin: 0 0 20px;
    }

    /* پنجره حذف */
    .delete-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: rgba(15, 23, 42, .62);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .delete-modal-backdrop.show {
            display: flex;
        }

    .delete-modal {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 20px;
        padding: 28px;
        text-align: center;
        box-shadow: 0 25px 70px rgba(0,0,0,.22);
        animation: modalShow .22s ease;
    }

    @@keyframes modalShow {
        from {
            opacity: 0;
            transform: translateY(12px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .delete-modal-icon {
        width: 66px;
        height: 66px;
        margin: 0 auto 17px;
        border-radius: 20px;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
    }

    .delete-modal h3 {
        color: #172554;
        font-size: 19px;
        font-weight: 900;
        margin: 0 0 12px;
    }

    .delete-modal p {
        color: #64748b;
        font-size: 13px;
        line-height: 2;
        margin: 0 0 22px;
    }

    .delete-user-name {
        display: block;
        color: #b91c1c;
        font-weight: 900;
        margin-top: 5px;
    }

    .delete-modal-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .modal-btn {
        min-width: 125px;
        border: none;
        border-radius: 10px;
        padding: 11px 17px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s;
    }

        .modal-btn:hover {
            transform: translateY(-2px);
        }

    .modal-btn-cancel {
        background: #f1f5f9;
        color: #475569;
    }

        .modal-btn-cancel:hover {
            background: #e2e8f0;
        }

    .modal-btn-delete {
        background: #dc2626;
        color: #fff;
    }

        .modal-btn-delete:hover {
            background: #b91c1c;
        }

    @@media (max-width: 768px) {
        .user-header {
            padding: 22px;
        }

            .user-header h2 {
                font-size: 19px;
            }

        .table-heading {
            padding: 17px;
        }

        .delete-modal {
            padding: 23px 18px;
        }
    }

    @@media (max-width: 420px) {
        .delete-modal-actions {
            flex-direction: column-reverse;
        }

        .modal-btn {
            width: 100%;
        }
    }
</style>

<div class="user-page">

    <div class="user-header">
        <div>
            <h2>مدیریت کاربران</h2>
            <p>در این بخش می‌توانید کاربران سامانه را مشاهده و مدیریت کنید.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="InsertUser"
           class="btn-add-user">
            <i class="bi bi-person-plus-fill"></i>
            افزودن کاربر جدید
        </a>
    </div>

    <div class="user-summary">

        <div class="summary-card">
            <div class="summary-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h3>@users.Count</h3>
                <span>تعداد کل کاربران</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <h3>@users.Count(u => u.UserIsActived)</h3>
                <span>کاربران فعال</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon" style="background:#fef3c7;color:#d97706;">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <div>
                <h3>@users.Count(u => !u.UserIsActived)</h3>
                <span>کاربران غیرفعال</span>
            </div>
        </div>

    </div>

    <div class="user-table-card">

        <div class="table-heading">
            <h3>
                <i class="bi bi-list-ul"></i>
                فهرست کاربران
            </h3>
            <span>مدیریت و کنترل کاربران ثبت‌شده در سامانه</span>
        </div>

        @if (users.Any())
        {
            <div class="table-responsive">
                <table class="user-table">
                    <thead>
                        <tr>
                            <th>تصویر و مشخصات کاربر</th>
                            <th>ایمیل</th>
                            <th>تاریخ ثبت‌نام</th>
                            <th>وضعیت حساب</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>
                                    <div class="user-info">

                                        @if (!string.IsNullOrWhiteSpace(user.UserProfileImageName))
                                        {
                                            <img src="@Url.Content("~/Image/Profile/" + user.UserProfileImageName)"
                                                 alt="@user.FirstName @user.LastName"
                                                 class="user-image"
                                                 onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />

                                            <div class="user-image-placeholder" style="display:none;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="user-image-placeholder">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                        }

                                        <div>
                                            <div class="user-name">
                                                @user.FirstName @user.LastName
                                            </div>
                                            <div class="user-username">
                                                @user.Username
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="user-email">@user.Email</span>
                                </td>

                                <td>
                                    @user.UserCreationDateToShamsi
                                </td>

                                <td>
                                    @if (user.UserIsActived)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle-fill"></i>
                                            غیرفعال
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <button type="button"
                                                class="action-btn btn-edit"
                                                onclick="openEditUserModal(this)"
                                                data-user-id="@user.UserID"
                                                data-first-name="@user.FirstName"
                                                data-last-name="@user.LastName"
                                                data-username="@user.Username"
                                                data-email="@user.Email"
                                                data-user-active="@user.UserIsActived"
                                                data-user-image="@user.UserProfileImageName">
                                            <i class="bi bi-pencil-square"></i>
                                            ویرایش
                                        </button>

                                        @if (user.UserIsActived)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="User"
                                                  asp-action="LoginAsUser"
                                                  asp-route-id="@user.UserID"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="action-btn btn-impersonate">
                                                    <i class="bi bi-person-fill-gear"></i>
                                                    ورود به‌جای کاربر
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="action-btn btn-impersonate"
                                                    disabled
                                                    title="کاربر غیرفعال می باشد">
                                                <i class="bi bi-person-fill-gear"></i>
                                                ورود به‌جای کاربر
                                            </button>
                                        }

                                        @if (user.UserIsActived)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="User"
                                                  asp-action="UserDeactivation"
                                                  asp-route-id="@user.UserID"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="action-btn btn-deactivate">
                                                    <i class="bi bi-pause-circle-fill"></i>
                                                    غیرفعال
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="User"
                                                  asp-action="UserActivation"
                                                  asp-route-id="@user.UserID"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="action-btn btn-activate">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    فعال
                                                </button>
                                            </form>
                                        }

                                        <button type="button"
                                                class="action-btn btn-delete"
                                                onclick="openDeleteModal(this)"
                                                data-user-name="@($"{user.FirstName} {user.LastName}")"
                                                data-delete-url="@Url.Action("DeleteUser", "User", new { area = "Admin", id = user.UserID })">
                                            <i class="bi bi-trash3-fill"></i>
                                            حذف
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h4>هنوز کاربری ثبت نشده است</h4>
                <p>برای شروع، اولین کاربر سامانه را ایجاد کنید.</p>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="InsertNewUser"
                   class="btn-add-user">
                    <i class="bi bi-person-plus-fill"></i>
                    افزودن اولین کاربر
                </a>
            </div>
        }

    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="delete-modal-backdrop"
     id="deleteModal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-modal">

        <div class="delete-modal-icon">
            <i class="bi bi-trash3-fill"></i>
        </div>

        <h3 id="deleteModalTitle">تأیید حذف کاربر</h3>

        <p>
            آیا از حذف این کاربر اطمینان دارید؟
            <span class="delete-user-name" id="deleteUserName"></span>
            <br />
            این عملیات باعث حذف کاربر از فهرست کاربران خواهد شد.
        </p>

        <div class="delete-modal-actions">

            <button type="button"
                    class="modal-btn modal-btn-cancel"
                    onclick="closeDeleteModal()">
                انصراف
            </button>

            <form id="deleteUserForm" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="modal-btn modal-btn-delete">
                    <i class="bi bi-trash3"></i>
                    بله، حذف شود
                </button>
            </form>

        </div>
    </div>
</div>

<!-- Edit User Partial View -->
@await Html.PartialAsync(
    "~/Areas/Admin/Views/Users/Edit.cshtml",
    new GCMS.Web.Areas.Admin.Models.ViewModel.User.UserEditByAdminViewModel()
)

<script>
    // Delete Modal
    const deleteModal = document.getElementById('deleteModal');
    const deleteForm = document.getElementById('deleteUserForm');
    const deleteUserName = document.getElementById('deleteUserName');

    function openDeleteModal(button) {
        const userName = button.getAttribute('data-user-name');
        const deleteUrl = button.getAttribute('data-delete-url');

        deleteUserName.textContent = userName;
        deleteForm.action = deleteUrl;

        deleteModal.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        deleteModal.classList.remove('show');
        document.body.style.overflow = '';
    }

    deleteModal.addEventListener('click', function(event) {
        if (event.target === deleteModal) {
            closeDeleteModal();
        }
    });

    // Edit User Modal
    const editUserModal = document.getElementById('editUserModal');

    function openEditUserModal(button) {

        document.getElementById('UserID').value =
            button.dataset.userId;

        document.getElementById('editFirstName').value =
            button.dataset.firstName;

        document.getElementById('editLastName').value =
            button.dataset.lastName;

        document.getElementById('editUsername').value =
            button.dataset.username;

        document.getElementById('editEmail').value =
            button.dataset.email;

        document.getElementById('editUserIsActived').value =
            button.dataset.userActive.toLowerCase();

        document.getElementById('editPassword').value = '';

        const imageName = button.dataset.userImage;
        const imagePreview = document.getElementById('editUserImagePreview');
        const imagePlaceholder = document.getElementById('editUserImagePlaceholder');

        if (imageName) {
            imagePreview.src = '/Image/Profile/' + encodeURIComponent(imageName);
            imagePreview.style.display = 'block';
            imagePlaceholder.style.display = 'none';
        }
        else {
            imagePreview.style.display = 'none';
            imagePlaceholder.style.display = 'flex';
        }

        document.getElementById('editUserProfileImage').value = '';

        editUserModal.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeEditUserModal() {
        editUserModal.classList.remove('show');
        document.body.style.overflow = '';
    }

    editUserModal.addEventListener('click', function(event) {
        if (event.target === editUserModal) {
            closeEditUserModal();
        }
    });

    // Close modals with Escape
    document.addEventListener('keydown', function(event) {

        if (event.key === 'Escape') {

            if (deleteModal.classList.contains('show')) {
                closeDeleteModal();
            }

            if (editUserModal.classList.contains('show')) {
                closeEditUserModal();
            }
        }
    });

    // Preview selected profile image
    document.getElementById('editUserProfileImage')
        .addEventListener('change', function(event) {

            const file = event.target.files[0];

            if (!file) return;

            const reader = new FileReader();

            reader.onload = function(e) {

                const preview = document.getElementById('editUserImagePreview');

                preview.src = e.target.result;
                preview.style.display = 'block';

                document.getElementById('editUserImagePlaceholder')
                    .style.display = 'none';
            };

            reader.readAsDataURL(file);
        });
</script>
