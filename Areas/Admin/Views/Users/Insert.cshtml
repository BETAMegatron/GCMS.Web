@model GCMS.Web.Areas.Admin.Models.ViewModel.User.UserCreateByAdminViewModel

@{
    ViewData["Title"] = "افزودن کاربر جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .create-user-page {
        direction: rtl;
        padding: 24px;
    }

    .page-header {
        background: linear-gradient(135deg, #172554, #2563eb);
        color: white;
        border-radius: 18px;
        padding: 25px 30px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        box-shadow: 0 8px 25px rgba(37, 99, 235, .15);
    }

        .page-header h2 {
            margin: 0 0 8px;
            font-size: 22px;
            font-weight: 800;
        }

        .page-header p {
            margin: 0;
            color: #dbeafe;
            font-size: 13px;
        }

    .header-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .form-card {
        background: white;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 5px 22px rgba(15, 23, 42, .06);
        border: 1px solid #edf0f5;
    }

    .section-title {
        font-size: 16px;
        font-weight: 800;
        color: #172554;
        padding-bottom: 14px;
        margin-bottom: 22px;
        border-bottom: 1px solid #edf0f5;
    }

    .form-label {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 10px 13px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        transition: .2s;
        background: #fff;
        color: #1e293b;
    }

        .form-control-custom:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .10);
        }

    textarea.form-control-custom {
        height: auto;
        min-height: 100px;
        resize: vertical;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .text-danger {
        display: block;
        font-size: 12px;
        margin-top: 6px;
    }

    .validation-summary-errors {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        border-radius: 10px;
        padding: 12px 18px;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-right: 20px;
        }

    .upload-box {
        border: 2px dashed #cbd5e1;
        border-radius: 14px;
        padding: 22px;
        text-align: center;
        background: #f8fafc;
        transition: .2s;
    }

        .upload-box:hover {
            border-color: #3b82f6;
            background: #eff6ff;
        }

    .upload-icon {
        font-size: 30px;
        color: #3b82f6;
        margin-bottom: 10px;
    }

    .upload-box input {
        display: block;
        width: 100%;
        margin-top: 14px;
        font-size: 12px;
    }

    .image-preview {
        display: none;
        margin: 18px auto 0;
        width: 115px;
        height: 115px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .15);
    }

    .status-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 15px 17px;
        margin-top: 5px;
    }

        .status-box strong {
            display: block;
            color: #1e293b;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .status-box small {
            color: #64748b;
            font-size: 11px;
        }

        .status-box input {
            width: 19px;
            height: 19px;
            accent-color: #2563eb;
            cursor: pointer;
        }

    .form-actions {
        display: flex;
        justify-content: flex-start;
        gap: 12px;
        border-top: 1px solid #edf0f5;
        padding-top: 22px;
        margin-top: 10px;
    }

    .btn-custom {
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: .2s;
    }

    .btn-submit {
        background: #2563eb;
        color: white;
    }

        .btn-submit:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-back {
        background: #f1f5f9;
        color: #475569;
    }

        .btn-back:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

    @@media (max-width: 768px) {
        .create-user-page {
            padding: 12px;
        }

        .form-card {
            padding: 18px;
        }

        .page-header {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-custom {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="create-user-page">

    <div class="page-header">
        <div>
            <h2>افزودن کاربر جدید</h2>
            <p>اطلاعات کاربر جدید را وارد کنید تا به سامانه اضافه شود.</p>
        </div>
        <div class="header-icon">
            <i class="fas fa-user-plus"></i>
        </div>
    </div>

    <div class="form-card">

        <form asp-area="Admin"
              asp-controller="User"
              asp-action="InsertNewUser"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="All"></div>

            <h4 class="section-title">اطلاعات حساب کاربری</h4>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FirstName" class="form-label">نام</label>
                        <input asp-for="FirstName"
                               class="form-control-custom"
                               placeholder="نام کاربر را وارد کنید" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="LastName" class="form-label">نام خانوادگی</label>
                        <input asp-for="LastName"
                               class="form-control-custom"
                               placeholder="نام خانوادگی را وارد کنید" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Username" class="form-label">نام کاربری</label>
                        <input asp-for="Username"
                               class="form-control-custom"
                               placeholder="نام کاربری را وارد کنید"
                               autocomplete="off" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">ایمیل</label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control-custom"
                               placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Password" class="form-label">رمز عبور</label>
                        <input asp-for="Password"
                               type="password"
                               class="form-control-custom"
                               placeholder="رمز عبور کاربر را وارد کنید"
                               autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <h4 class="section-title" style="margin-top: 15px;">تصویر پروفایل</h4>

            <div class="form-group">
                <div class="upload-box">
                    <div class="upload-icon">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <strong>انتخاب تصویر پروفایل</strong>
                    <p style="color:#64748b;font-size:12px;margin:7px 0;">
                        تصویر مورد نظر را انتخاب کنید.
                    </p>

                    <input asp-for="UserProfileImage"
                           type="file"
                           id="UserProfileImage"
                           accept="image/*" />

                    <img id="profilePreview"
                         class="image-preview"
                         alt="پیش‌نمایش تصویر پروفایل" />
                </div>
                <span asp-validation-for="UserProfileImage" class="text-danger"></span>
            </div>

            <h4 class="section-title" style="margin-top: 25px;">وضعیت حساب</h4>

            <div class="status-box">
                <div>
                    <strong>فعال بودن حساب کاربری</strong>
                    <small>در صورت فعال بودن، کاربر امکان ورود به سامانه را خواهد داشت.</small>
                </div>

                <input asp-for="UserIsActived" type="checkbox" />
            </div>

            <div  class="form-actions">
                <button asp-area="Admin"
                        asp-controller="User"
                        asp-action="InsertUser" type="submit" class="btn-custom btn-submit">
                    <i class="fas fa-save"></i>
                    ثبت کاربر
                </button>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="btn-custom btn-back">
                    <i class="fas fa-arrow-right"></i>
                    بازگشت به لیست کاربران
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("UserProfileImage").addEventListener("change", function(event) {
            const file = event.target.files[0];
            const preview = document.getElementById("profilePreview");

            if (!file) {
                preview.style.display = "none";
                preview.removeAttribute("src");
                return;
            }

            if (!file.type.startsWith("image/")) {
                alert("لطفاً یک فایل تصویری انتخاب کنید.");
                event.target.value = "";
                preview.style.display = "none";
                return;
            }

            preview.src = URL.createObjectURL(file);
            preview.style.display = "block";
        });
    </script>
}